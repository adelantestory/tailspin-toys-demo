---
interface Props {
    gameId: number;
    max?: number;
}

const { gameId, max = 4 } = Astro.props;
const stars = Array.from({ length: max }, (_, i) => i + 1);
---

<div
    class="flex items-center gap-1"
    data-rating-input
    data-game-id={gameId}
    data-max={max}
    data-value="0"
    role="radiogroup"
    aria-label="Rate this game"
    data-testid={`game-rating-input-${gameId}`}
>
    {stars.map((value) => (
        <button
            type="button"
            class="star-btn text-slate-500 hover:text-yellow-400 focus:text-yellow-400 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded transition-colors"
            data-value={value}
            data-testid={`star-${gameId}-${value}`}
            role="radio"
            aria-checked="false"
            aria-label={`${value} star${value === 1 ? '' : 's'}`}
        >
            <svg
                class="star-icon w-5 h-5"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 2l2.39 4.84 5.34.78-3.87 3.77.91 5.31L10 14.19l-4.77 2.51.91-5.31L2.27 7.62l5.34-.78L10 2z"
                />
            </svg>
        </button>
    ))}
</div>

<script>
    type RatingContainer = HTMLElement & { dataset: DOMStringMap };

    function applyRating(container: RatingContainer, value: number): void {
        const buttons = container.querySelectorAll<HTMLButtonElement>('button.star-btn');
        buttons.forEach((btn) => {
            const btnValue = Number(btn.dataset.value ?? '0');
            const filled = btnValue <= value && value > 0;
            const icon = btn.querySelector<SVGElement>('svg.star-icon');
            if (icon) {
                icon.setAttribute('fill', filled ? 'currentColor' : 'none');
            }
            btn.classList.toggle('text-yellow-400', filled);
            btn.classList.toggle('text-slate-500', !filled);
            btn.setAttribute('aria-checked', btnValue === value ? 'true' : 'false');
        });
        container.dataset.value = String(value);
    }

    function initRating(container: RatingContainer): void {
        const gameId = container.dataset.gameId;
        if (!gameId) return;
        const storageKey = `tailspin-toys:game-rating:${gameId}`;

        let stored = 0;
        try {
            stored = Number(window.localStorage.getItem(storageKey) ?? '0') || 0;
        } catch {
            /* localStorage unavailable — fall back to no stored rating */
        }
        if (stored > 0) applyRating(container, stored);

        container.querySelectorAll<HTMLButtonElement>('button.star-btn').forEach((btn) => {
            btn.addEventListener('click', (event: MouseEvent) => {
                event.preventDefault();
                event.stopPropagation();
                const value = Number(btn.dataset.value ?? '0');
                applyRating(container, value);
                try {
                    window.localStorage.setItem(storageKey, String(value));
                } catch {
                    /* localStorage unavailable — rating persists for this view only */
                }
            });
        });
    }

    document
        .querySelectorAll<HTMLElement>('[data-rating-input]')
        .forEach((el) => initRating(el as RatingContainer));
</script>
